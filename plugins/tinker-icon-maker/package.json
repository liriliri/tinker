{
  "name": "tinker-icon-maker",
  "version": "0.1.0",
  "description": "Create app icons with background, shape, and multi-size PNG export",
  "scripts": {
    "dev": "vite build --watch --config ../vite.config.ts",
    "build": "vite build --config ../vite.config.ts",
    "build:web": "npm run build && zx ../../script/web.mjs --copy"
  },
  "tinker": {
    "name": "Icon Maker",
    "category": "media",
    "icon": "icon.png",
    "main": "dist/index.html",
    "locales": {
      "zh-CN": {
        "name": "图标制作",
        "description": "制作应用图标，支持背景、形状与多尺寸 PNG 导出"
      }
    }
  }
}
